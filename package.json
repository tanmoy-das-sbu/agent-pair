{
  "name": "@tnmy57/agent-pair",
  "version": "0.3.0",
  "description": "Coordinate Codex, Antigravity, and Claude Code sessions in one workspace",
  "type": "module",
  "bin": {
    "agent-pair": "dist/cli.js"
  },
  "files": [
    "dist",
