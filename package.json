{
  "name": "@tnmy57/agent-pair",
  "version": "0.4.0",
  "description": "Coordinate Codex, Antigravity, and Claude Code sessions in one workspace",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/tanmoy-das-sbu/agent-pair.git" },
  "bugs": { "url": "https://github.com/tanmoy-das-sbu/agent-pair/issues" },
  "homepage": "https://github.com/tanmoy-das-sbu/agent-pair#readme",
  "keywords": ["mcp", "multi-agent", "codex", "claude-code", "antigravity", "ai-agents", "orchestration", "developer-tools"],
  "type": "module",
  "bin": {
    "agent-pair": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "templates",
    "bench",
    "docs",
    "README.md",
    "PLAN.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs test/*/*.test.mjs bench/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "smol-toml": "1.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
